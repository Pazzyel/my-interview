# Host ports
BACKEND_BIND_ADDRESS=0.0.0.0
FRONTEND_BIND_ADDRESS=0.0.0.0
INFRA_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8072
FRONTEND_PORT=80
COMPOSE_NETWORK_NAME=interview-network
MYSQL_PORT=3308
MILVUS_GRPC_PORT=19530
MILVUS_WEBUI_PORT=9091
ROCKETMQ_NAMESERVER_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_PROXY_HTTP_PORT=8080
ROCKETMQ_PROXY_GRPC_PORT=8081
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Local infrastructure credentials. Use URL-safe characters in MYSQL_ROOT_PASSWORD.
MYSQL_ROOT_PASSWORD=interview_dev_password
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin_dev_secret
RUSTFS_REGION_NAME=us-east-1
RUSTFS_BUCKET_NAME=resources
RUSTFS_KB_BUCKET_NAME=knowledgebases

# 32-byte random material is recommended in production. Never change it after
# provider keys have been encrypted unless all stored provider credentials are reset.
LLM_PROVIDER_ENCRYPTION_KEY=replace-with-a-long-random-secret

# OpenAI-compatible LLM/embedding bootstrap provider. It is only imported when
# the provider tables are empty; later changes are managed through the Provider API.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-me
LLM_CHAT_MODEL=qwen-plus
LLM_EMBEDDING_MODEL=text-embedding-v4
LLM_EMBEDDING_DIMENSIONS=1024

# Optional when connecting to an authenticated external Milvus deployment.
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=smart_service
MILVUS_CONSISTENCY_LEVEL=Session

# The current realtime speech adapter implements the DashScope WebSocket protocol.
VOICE_DASHSCOPE_API_KEY=
VOICE_DASHSCOPE_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
VOICE_PUBLIC_WS_BASE_URL=

# Pydantic list values must be JSON.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
